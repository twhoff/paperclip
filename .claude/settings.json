{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "context-mode hook claude-code posttooluse",
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "holly hooks post-tool-use"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "context-mode hook claude-code precompact",
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "holly hooks pre-compact"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "bash scripts/context-mode/pretooluse-wrapper.sh",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "context-mode hook claude-code pretooluse",
            "type": "command"
          }
        ],
        "matcher": "Read"
      },
      {
        "hooks": [
          {
            "command": "context-mode hook claude-code pretooluse",
            "type": "command"
          }
        ],
        "matcher": "Grep"
      },
      {
        "hooks": [
          {
            "command": "context-mode hook claude-code pretooluse",
            "type": "command"
          }
        ],
        "matcher": "WebFetch"
      },
      {
        "hooks": [
          {
            "command": "context-mode hook claude-code pretooluse",
            "type": "command"
          }
        ],
        "matcher": "Task"
      },
      {
        "hooks": [
          {
            "command": "context-mode hook claude-code pretooluse",
            "type": "command"
          }
        ],
        "matcher": "mcp__context-mode__ctx_execute"
      },
      {
        "hooks": [
          {
            "command": "context-mode hook claude-code pretooluse",
            "type": "command"
          }
        ],
        "matcher": "mcp__context-mode__ctx_execute_file"
      },
      {
        "hooks": [
          {
            "command": "context-mode hook claude-code pretooluse",
            "type": "command"
          }
        ],
        "matcher": "mcp__context-mode__ctx_batch_execute"
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "holly hooks pre-tool-use"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash scripts/context-mode/sessionstart-wrapper.sh",
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "holly hooks session-start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "holly hooks user-prompt-submit"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "holly hooks session-end"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "holly hooks subagent-start"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "holly hooks subagent-stop"
          }
        ]
      }
    ]
  }
}
