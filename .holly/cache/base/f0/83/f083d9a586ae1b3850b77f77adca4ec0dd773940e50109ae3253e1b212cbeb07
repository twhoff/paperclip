test('resolveOutputPaths: default suffix increments across same-day runs', () => {
  // first call
  const r1 = resolveOutputPaths({
    arg: undefined,
    projectRoot: tmp,
    viewports: VPS,
    ext: 'png',
    today: '2026-05-04',
    cwd: '/home/user/app',
    tmpBase: tmp,
  });
  fs.mkdirSync(r1.outputDir, { recursive: true });
  // second call should pick the next suffix
  const r2 = resolveOutputPaths({
    arg: undefined,
    projectRoot: tmp,
    viewports: VPS,
    ext: 'png',
    today: '2026-05-04',
    cwd: '/home/user/app',
    tmpBase: tmp,
  });
  assert.equal(path.basename(r1.outputDir), '2026-05-04-a');
  assert.equal(path.basename(r2.outputDir), '2026-05-04-b');
});

test('resolveOutputPaths: issue-scoped agent-fs captures use session scratch', () => {
  const fakeBin = path.join(tmp, 'agent-fs');
  const logPath = path.join(tmp, 'agent-fs-args.json');
  const scratchDir = path.join(tmp, 'agent-scratch', 'scratch', 'ui-visual-capture-gro-829-2026-05-04');
  fs.writeFileSync(
    fakeBin,
    `#!/usr/bin/env node\nconst fs = require('node:fs');\nfs.writeFileSync(${JSON.stringify(logPath)}, JSON.stringify(process.argv.slice(2)));\nconsole.log(${JSON.stringify(scratchDir)});\n`,
  );
  fs.chmodSync(fakeBin, 0o755);

  const previous = process.env.AGENT_FS_BIN;
  process.env.AGENT_FS_BIN = fakeBin;
  let result;
  try {
    result = resolveOutputPaths({
      arg: undefined,
      projectRoot: tmp,
      viewports: VPS,
      ext: 'png',
      today: '2026-05-04',
      cwd: '/Users/twhoffmann/Projects/groceries-system-worktrees/gro-829',
    });
  } finally {
    if (previous === undefined) delete process.env.AGENT_FS_BIN;
    else process.env.AGENT_FS_BIN = previous;
  }

  assert.equal(result.outputDir, scratchDir);
  assert.deepEqual(JSON.parse(fs.readFileSync(logPath, 'utf8')), [
    'scratch',
    'ui-visual-capture-gro-829-2026-05-04',
  ]);
});
