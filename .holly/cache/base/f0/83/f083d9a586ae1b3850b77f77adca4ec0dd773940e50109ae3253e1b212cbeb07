test('detectIssueKey: returns null for normal project paths', () => {
  assert.equal(detectIssueKey('/Users/twhoffmann/Projects/groceries-system'), null);
  assert.equal(detectIssueKey('/home/user/code/myapp'), null);
});

test('detectIssueKey: returns null for empty path', () => {
  assert.equal(detectIssueKey('/'), null);
});

// resolveOutputPaths
const VPS = [
  { name: 'mobile', width: 390, height: 844 },
  { name: 'desktop', width: 1280, height: 900 },
];

test('resolveOutputPaths: default with no issue key uses tmpBase/<date>-<suffix>/<name>.<ext>', () => {
  const result = resolveOutputPaths({
    arg: undefined,
    projectRoot: tmp,
    viewports: VPS,
    ext: 'png',
    today: '2026-05-04',
    cwd: '/home/user/projects/myapp',
    tmpBase: tmp,
  });
  const dir = path.join(tmp, '2026-05-04-a');
  assert.equal(result.outputDir, dir);
  assert.equal(result.paths.get('mobile'), path.join(dir, 'mobile.png'));
  assert.equal(result.paths.get('desktop'), path.join(dir, 'desktop.png'));
});

