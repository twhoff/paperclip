// ─── classifyGitContext ───────────────────────────────────────────────────────

test('classifyGitContext: .git as directory → main checkout', () => {
  const repo = path.join(tmp, 'repo');
  fs.mkdirSync(path.join(repo, '.git'), { recursive: true });
  const r = classifyGitContext(repo);
  assert.equal(r.isWorktree, false);
  assert.equal(r.worktreeRoot, null);
});

test('classifyGitContext: .git as file → linked worktree', () => {
  const wt = path.join(tmp, 'worktrees', 'gro-829');
  fs.mkdirSync(wt, { recursive: true });
  fs.writeFileSync(path.join(wt, '.git'), 'gitdir: /repo/.git/worktrees/gro-829\n');
  const r = classifyGitContext(wt);
  assert.equal(r.isWorktree, true);
  assert.equal(r.worktreeRoot, wt);
});

test('classifyGitContext: walks up from nested dir to find .git', () => {
  const wt = path.join(tmp, 'worktrees', 'gro-829');
  const nested = path.join(wt, 'frontend', 'src', 'components');
  fs.mkdirSync(nested, { recursive: true });
  fs.writeFileSync(path.join(wt, '.git'), 'gitdir: /repo/.git/worktrees/gro-829\n');
  const r = classifyGitContext(nested);
  assert.equal(r.isWorktree, true);
  assert.equal(r.worktreeRoot, wt);
});

test('classifyGitContext: no .git anywhere → not a worktree', () => {
  const isolated = path.join(tmp, 'isolated');
  fs.mkdirSync(isolated, { recursive: true });
  const r = classifyGitContext(isolated);
  assert.equal(r.isWorktree, false);
  assert.equal(r.worktreeRoot, null);
});

// ─── findFrontendPackage ──────────────────────────────────────────────────────

test('findFrontendPackage: returns first matching FRONTEND_CANDIDATES dir', () => {
  const root = path.join(tmp, 'repo');
  const feDir = path.join(root, 'frontend');
  fs.mkdirSync(feDir, { recursive: true });
  fs.writeFileSync(
    path.join(feDir, 'package.json'),
    JSON.stringify({ scripts: { dev: 'next dev' }, dependencies: { next: '14.0.0' } }),
  );
  const result = findFrontendPackage(root);
  assert.equal(result.dir, feDir);
  assert.equal(result.packageJson.scripts.dev, 'next dev');
});

test('findFrontendPackage: skips candidate dirs without a dev script', () => {
  const root = path.join(tmp, 'repo');
  const feDir = path.join(root, 'frontend');
  const uiDir = path.join(root, 'ui');
  fs.mkdirSync(feDir, { recursive: true });
  fs.mkdirSync(uiDir, { recursive: true });
  fs.writeFileSync(
    path.join(feDir, 'package.json'),
    JSON.stringify({ scripts: { build: 'next build' } }),
  );
  fs.writeFileSync(
    path.join(uiDir, 'package.json'),
    JSON.stringify({ scripts: { dev: 'vite' }, devDependencies: { vite: '5.0.0' } }),
  );
  const result = findFrontendPackage(root);
  assert.equal(result.dir, uiDir);
});

test('findFrontendPackage: falls back to root package.json', () => {
  const root = path.join(tmp, 'repo');
  fs.mkdirSync(root, { recursive: true });
  fs.writeFileSync(
    path.join(root, 'package.json'),
    JSON.stringify({ scripts: { dev: 'pnpm dev' } }),
  );
  const result = findFrontendPackage(root);
  assert.equal(result.dir, root);
});

test('findFrontendPackage: returns null when no package with dev script found', () => {
  const root = path.join(tmp, 'repo');
  fs.mkdirSync(root, { recursive: true });
  assert.equal(findFrontendPackage(root), null);
});

test(`findFrontendPackage: checks all of [${FRONTEND_CANDIDATES.join(', ')}] before root`, () => {
  // Only the last candidate has a dev script
  const root = path.join(tmp, 'repo');
  const lastCandidate = FRONTEND_CANDIDATES[FRONTEND_CANDIDATES.length - 1];
  const lastDir = path.join(root, lastCandidate);
  fs.mkdirSync(lastDir, { recursive: true });
  fs.writeFileSync(
    path.join(lastDir, 'package.json'),
    JSON.stringify({ scripts: { dev: 'vite' } }),
  );
  const result = findFrontendPackage(root);
  assert.equal(result.dir, lastDir);
});

