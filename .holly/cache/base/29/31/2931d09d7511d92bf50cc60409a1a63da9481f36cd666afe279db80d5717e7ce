// ─── buildDevSpawnArgs ───────────────────────────────────────────────────────

test('buildDevSpawnArgs: next + pnpm → pnpm run dev with PORT env', () => {
  const pkg = { dependencies: { next: '14.0.0' }, scripts: { dev: 'next dev' } };
  const { args, envOverride } = buildDevSpawnArgs(pkg, 'pnpm', 3101);
  assert.deepEqual(args, ['pnpm', 'run', 'dev']);
  assert.equal(envOverride.PORT, '3101');
});

test('buildDevSpawnArgs: vite + pnpm → pnpm run dev -- --port PORT --host', () => {
  const pkg = { devDependencies: { vite: '5.0.0' }, scripts: { dev: 'vite' } };
  const { args, envOverride } = buildDevSpawnArgs(pkg, 'pnpm', 3102);
  assert.ok(args.includes('--port'), 'must include --port');
  assert.ok(args.includes('3102'), 'must include port number');
  assert.ok(args.includes('--host'), 'must include --host');
  assert.ok(args.includes('--'), 'must pass -- separator');
  // Vite does not use PORT env var; envOverride should be empty
  assert.equal(Object.keys(envOverride).length, 0);
});

test('buildDevSpawnArgs: yarn package manager', () => {
  const pkg = { dependencies: { next: '14.0.0' } };
  const { args } = buildDevSpawnArgs(pkg, 'yarn', 3000);
