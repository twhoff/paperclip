test('saveServerMetadata and loadServerMetadata round-trip', () => {
  const reg = path.join(tmp, 'registry');
  const data = { port: 3000, pid: 12345, worktreeRoot: '/wt', lastUsedAt: Date.now() };
  saveServerMetadata(3000, data, reg);
  assert.deepEqual(loadServerMetadata(3000, reg), data);
});

test('loadServerMetadata returns null for a missing file', () => {
  const reg = path.join(tmp, 'registry');
  assert.equal(loadServerMetadata(3000, reg), null);
});

test('saveServerMetadata creates registry dir if needed', () => {
  const reg = path.join(tmp, 'new', 'registry');
  saveServerMetadata(3000, { port: 3000, pid: 1 }, reg);
  assert.ok(fs.existsSync(reg));
});

test('touchServerMetadata updates lastUsedAt', async () => {
  const reg = path.join(tmp, 'registry');
  const before = Date.now() - 5;
  saveServerMetadata(3000, { port: 3000, pid: 1, worktreeRoot: '/wt', lastUsedAt: before }, reg);
  // Ensure time advances
  await new Promise((r) => setTimeout(r, 10));
  touchServerMetadata(3000, reg);
  const updated = loadServerMetadata(3000, reg);
  assert.ok(updated.lastUsedAt > before, `lastUsedAt ${updated.lastUsedAt} should be > ${before}`);
});

test('touchServerMetadata is a no-op when metadata is missing', () => {
  const reg = path.join(tmp, 'registry');
  assert.doesNotThrow(() => touchServerMetadata(3000, reg));
});

test('clearServerMetadata removes the file', () => {
  const reg = path.join(tmp, 'registry');
  saveServerMetadata(3000, { port: 3000, pid: 1 }, reg);
  clearServerMetadata(3000, reg);
  assert.equal(loadServerMetadata(3000, reg), null);
});

test('clearServerMetadata is a no-op when file is missing', () => {
  const reg = path.join(tmp, 'registry');
  assert.doesNotThrow(() => clearServerMetadata(3000, reg));
});

// ─── checkPortServing ─────────────────────────────────────────────────────────

test('checkPortServing: returns true when a server is responding', async () => {
  const server = http.createServer((_, res) => res.end('ok'));
  await new Promise((r) => server.listen(0, '127.0.0.1', r));
  const port = server.address().port;
  try {
    assert.equal(await checkPortServing(port), true);
  } finally {
    await new Promise((r) => server.close(r));
  }
});

test('checkPortServing: returns false for a closed port', async () => {
  // Get a free port and immediately release it, then probe it
  const server = http.createServer();
  await new Promise((r) => server.listen(0, '127.0.0.1', r));
  const port = server.address().port;
  await new Promise((r) => server.close(r));
  assert.equal(await checkPortServing(port, { timeout: 300 }), false);
});

// ─── decideServerMode ─────────────────────────────────────────────────────────

// Helper: build a fake worktree directory with optional frontend package
function makeWorktree(base, name, { withFrontend = false, frameworkPkg = null } = {}) {
  const wt = path.join(base, 'worktrees', name);
  fs.mkdirSync(wt, { recursive: true });
  fs.writeFileSync(path.join(wt, '.git'), `gitdir: /repo/.git/worktrees/${name}\n`);
  if (withFrontend) {
    const feDir = path.join(wt, 'frontend');
    fs.mkdirSync(feDir, { recursive: true });
    const pkg = frameworkPkg ?? { scripts: { dev: 'next dev' }, dependencies: { next: '14.0.0' } };
    fs.writeFileSync(path.join(feDir, 'package.json'), JSON.stringify(pkg));
  }
  return wt;
}

function makeMainCheckout(base) {
  const repo = path.join(base, 'repo');
  fs.mkdirSync(path.join(repo, '.git'), { recursive: true });
  return repo;
}

test('decideServerMode: free port + main checkout → require-running', async () => {
  const reg = path.join(tmp, 'reg');
  const dir = makeMainCheckout(tmp);
  const result = await decideServerMode({ port: 59990, cwd: dir, registryDir: reg });
  assert.equal(result.mode, 'require-running');
  assert.match(result.reason, /main checkout/i);
});

test('decideServerMode: free port + worktree + frontend → start', async () => {
  const reg = path.join(tmp, 'reg');
  const wt = makeWorktree(tmp, 'gro-829', { withFrontend: true });
  const result = await decideServerMode({ port: 59991, cwd: wt, registryDir: reg });
  assert.equal(result.mode, 'start');
  assert.equal(result.packageDir, path.join(wt, 'frontend'));
  assert.equal(result.worktreeRoot, wt);
});

test('decideServerMode: free port + worktree + no frontend → conflict', async () => {
  const reg = path.join(tmp, 'reg');
  const wt = makeWorktree(tmp, 'gro-829', { withFrontend: false });
  const result = await decideServerMode({ port: 59992, cwd: wt, registryDir: reg });
  assert.equal(result.mode, 'conflict');
  assert.match(result.reason, /Could not find/i);
});

test('decideServerMode: serving port + main checkout + no metadata → no-server', async () => {
  const reg = path.join(tmp, 'reg');
  const dir = makeMainCheckout(tmp);
  const server = http.createServer((_, res) => res.end('ok'));
  await new Promise((r) => server.listen(0, '127.0.0.1', r));
  const port = server.address().port;
  try {
    const result = await decideServerMode({ port, cwd: dir, registryDir: reg });
    assert.equal(result.mode, 'no-server');
  } finally {
    await new Promise((r) => server.close(r));
  }
});

test('decideServerMode: serving port + worktree + same-worktree metadata → attach', async () => {
  const reg = path.join(tmp, 'reg');
  const wt = makeWorktree(tmp, 'gro-829', { withFrontend: true });
  const server = http.createServer((_, res) => res.end('ok'));
  await new Promise((r) => server.listen(0, '127.0.0.1', r));
  const port = server.address().port;
  saveServerMetadata(port, { port, pid: 999, worktreeRoot: wt, lastUsedAt: Date.now() }, reg);
  try {
    const result = await decideServerMode({ port, cwd: wt, registryDir: reg });
    assert.equal(result.mode, 'attach');
    assert.equal(result.worktreeRoot, wt);
    assert.equal(result.pid, 999);
  } finally {
    await new Promise((r) => server.close(r));
  }
});

test('decideServerMode: serving port + worktree + different-worktree metadata → conflict', async () => {
  const reg = path.join(tmp, 'reg');
  const wt1 = makeWorktree(tmp, 'gro-829', { withFrontend: true });
  const wt2 = makeWorktree(tmp, 'gro-830', { withFrontend: true });
  const server = http.createServer((_, res) => res.end('ok'));
  await new Promise((r) => server.listen(0, '127.0.0.1', r));
  const port = server.address().port;
  saveServerMetadata(port, { port, pid: 999, worktreeRoot: wt2, lastUsedAt: Date.now() }, reg);
  try {
    const result = await decideServerMode({ port, cwd: wt1, registryDir: reg });
    assert.equal(result.mode, 'conflict');
    assert.match(result.reason, /different worktree/i);
    assert.match(result.reason, /--attach-existing/i);
  } finally {
    await new Promise((r) => server.close(r));
  }
});

test('decideServerMode: serving port + worktree + no metadata → conflict', async () => {
  const reg = path.join(tmp, 'reg');
  const wt = makeWorktree(tmp, 'gro-829', { withFrontend: true });
  const server = http.createServer((_, res) => res.end('ok'));
  await new Promise((r) => server.listen(0, '127.0.0.1', r));
  const port = server.address().port;
  try {
    const result = await decideServerMode({ port, cwd: wt, registryDir: reg });
    assert.equal(result.mode, 'conflict');
    assert.match(result.reason, /unknown process/i);
    assert.match(result.reason, /--attach-existing/i);
  } finally {
    await new Promise((r) => server.close(r));
  }
});

test('decideServerMode: --attach-existing overrides a conflict', async () => {
  const reg = path.join(tmp, 'reg');
  const wt1 = makeWorktree(tmp, 'gro-829', { withFrontend: true });
  const wt2 = makeWorktree(tmp, 'gro-830', { withFrontend: true });
  const server = http.createServer((_, res) => res.end('ok'));
  await new Promise((r) => server.listen(0, '127.0.0.1', r));
  const port = server.address().port;
  saveServerMetadata(port, { port, pid: 999, worktreeRoot: wt2, lastUsedAt: Date.now() }, reg);
  try {
    const result = await decideServerMode({ port, cwd: wt1, registryDir: reg, attachExisting: true });
    assert.equal(result.mode, 'attach-explicit');
  } finally {
    await new Promise((r) => server.close(r));
  }
});

test('decideServerMode: touch is called on attach (metadata lastUsedAt updates)', async () => {
  const reg = path.join(tmp, 'reg');
  const wt = makeWorktree(tmp, 'gro-829', { withFrontend: true });
  const before = Date.now() - 10;
  const server = http.createServer((_, res) => res.end('ok'));
  await new Promise((r) => server.listen(0, '127.0.0.1', r));
  const port = server.address().port;
  saveServerMetadata(port, { port, pid: 999, worktreeRoot: wt, lastUsedAt: before }, reg);
  try {
    await decideServerMode({ port, cwd: wt, registryDir: reg });
    const after = loadServerMetadata(port, reg);
    assert.ok(after.lastUsedAt >= before);
  } finally {
    await new Promise((r) => server.close(r));
  }
});
